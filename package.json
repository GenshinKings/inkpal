{
  "name": "inkpal",
  "version": "0.2.0",
  "description": "Ask your notes: vault Q&A with citations + writing assist that completes but never ghost-writes.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:vault": "node scripts/vault-smoke.mts",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
